<view wx:if="{{visible}}" class="cal-mask" bindtap="close" catchtouchmove="stop">
  <view class="cal" catchtap="stop">
    <view class="cal__head">
      <view class="cal__nav" hover-class="cal__nav--h" bindtap="prev">‹</view>
      <view class="cal__title">{{title}}</view>
      <view class="cal__nav" hover-class="cal__nav--h" bindtap="next">›</view>
    </view>
    <view class="cal__week">
      <text>日</text><text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text>
    </view>
    <view class="cal__grid">
      <block wx:for="{{weeks}}" wx:key="index" wx:for-item="w">
        <view
          wx:for="{{w}}"
          wx:key="index"
          wx:for-item="c"
          class="cal__cell {{c.day ? '' : 'cal__cell--empty'}} {{c.isSel ? 'sel' : ''}} {{c.isToday ? 'today' : ''}}"
          data-date="{{c.date}}"
          bindtap="pick"
        >{{c.day}}</view>
      </block>
    </view>
    <view class="cal__foot">
      <view class="cal__today" hover-class="pressed" hover-stay-time="80" bindtap="today">回到今天</view>
    </view>
  </view>
</view>
