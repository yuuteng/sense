.cal-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 200;
  background: rgba(62, 69, 80, 0.45);
  display: flex; align-items: center; justify-content: center;
}
.cal {
  width: 640rpx; background: var(--surface); border-radius: var(--radius-lg);
  padding: 32rpx; box-shadow: 0 24rpx 60rpx rgba(62, 69, 80, 0.24);
}
.cal__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.cal__title { font-size: var(--text-lg); font-weight: 600; }
.cal__nav { width: 72rpx; height: 72rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 44rpx; color: var(--muted); }
.cal__nav--h { background: rgba(62, 69, 80, 0.06); }
.cal__week { display: grid; grid-template-columns: repeat(7, 1fr); margin-bottom: 8rpx; }
.cal__week text { text-align: center; font-size: 24rpx; color: var(--muted); }
.cal__grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4rpx; }
.cal__cell {
  height: 80rpx; display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; border-radius: 16rpx; font-variant-numeric: tabular-nums;
}
.cal__cell--empty { pointer-events: none; }
.cal__cell.today { color: var(--accent-ink); font-weight: 700; }
.cal__cell.sel { background: var(--accent); color: #fff; font-weight: 700; }
.cal__foot { display: flex; justify-content: center; margin-top: 20rpx; }
.cal__today { font-size: 28rpx; color: var(--accent-ink); padding: 12rpx 28rpx; border-radius: var(--radius-pill); }
.cal__today.pressed { background: rgba(0, 204, 249, 0.12); }
