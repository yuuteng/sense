.cp-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 300;
  background: rgba(62, 69, 80, 0);
  transition: background 300ms ease;
  display: flex; align-items: flex-end;
}
.cp-mask--show { background: rgba(62, 69, 80, 0.45); }

.cp {
  width: 100%; background: var(--surface);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  max-height: 76%; display: flex; flex-direction: column;
  transform: translateY(101%);
  transition: transform 340ms cubic-bezier(0.16, 1, 0.3, 1); /* iOS 风缓冲：先快后缓 */
  will-change: transform;
}
.cp--up { transform: translateY(0); }

.cp__grab { width: 72rpx; height: 8rpx; border-radius: 999rpx; background: var(--border); margin: 16rpx auto 0; flex-shrink: 0; }
.cp__title { text-align: center; font-size: var(--text-lg); font-weight: 600; padding: 20rpx 32rpx 24rpx; flex-shrink: 0; }
.cp__list { flex: 1; }
.cp__row { display: flex; align-items: center; gap: 24rpx; padding: 30rpx 40rpx; font-size: 34rpx; }
.cp__row + .cp__row { border-top: 1rpx solid var(--border); }
.cp__row:active { background: rgba(62, 69, 80, 0.05); }
.cp__sym { width: 64rpx; text-align: center; font-weight: 600; }
.cp__name { flex: 1; }
.cp__code { color: var(--muted); font-size: 26rpx; font-family: var(--font-mono); }
.cp__row.sel { color: var(--accent-ink); font-weight: 600; }
.cp__row.sel .cp__code { color: var(--accent-ink); }
