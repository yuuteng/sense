<view class="nav">
  <view class="status-spacer" style="height: {{statusBarHeight}}px"></view>
  <view class="appbar" style="height: {{navBarHeight}}px; padding-right: {{rightGap}}px">
    <view class="appbar__side {{back ? 'reserve' : ''}}">
      <view wx:if="{{back}}" class="appbar__btn" hover-class="active" hover-stay-time="80" bindtap="onBack">
        <image class="nav-ic" src="{{backIcon}}"></image>
      </view>
      <slot wx:else name="left"></slot>
    </view>

    <view wx:if="{{!center}}" class="appbar__title">
      <block wx:if="{{title}}">{{title}}<text wx:if="{{sub}}" class="sub">{{sub}}</text></block>
      <slot wx:else name="title"></slot>
    </view>

    <view class="appbar__side appbar__side--right">
      <slot name="right"></slot>
    </view>
  </view>

  <!-- 居中标题：绝对定位，相对整屏水平居中，不受两侧控件影响 -->
  <view wx:if="{{center}}" class="appbar__center" style="top: {{statusBarHeight}}px; height: {{navBarHeight}}px">
    <view class="appbar__center-inner">
      {{title}}<text wx:if="{{sub}}" class="sub">{{sub}}</text>
    </view>
  </view>
</view>
