.bs-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 300;
  background: rgba(62, 69, 80, 0);
  transition: background 300ms ease;
  display: flex; align-items: flex-end;
}
.bs-mask--show { background: rgba(62, 69, 80, 0.45); }

.bs {
  width: 100%; background: var(--surface);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  max-height: 76%; display: flex; flex-direction: column;
  transform: translateY(101%);
  transition: transform 340ms cubic-bezier(0.16, 1, 0.3, 1); /* iOS 风缓冲：先快后缓 */
  will-change: transform;
}
.bs--up { transform: translateY(0); }

.bs__grab { width: 72rpx; height: 8rpx; border-radius: 999rpx; background: var(--border); margin: 16rpx auto 0; flex-shrink: 0; }
.bs__title { text-align: center; font-size: var(--text-lg); font-weight: 600; padding: 20rpx 32rpx 24rpx; flex-shrink: 0; }
/* scroll-view + max-height：账本少时自适应，多时可滚。
   view 的 overflow-y:auto 在真机不可滚（见 stats.wxss 同款教训），必须 scroll-view */
.bs__list { max-height: 56vh; }

.bs__row { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 40rpx; }
.bs__row + .bs__row { border-top: 1rpx solid var(--border); }
.bs__row:active { background: rgba(62, 69, 80, 0.05); }
.bs__ic { width: 76rpx; height: 76rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.bs__ic image { width: 40rpx; height: 40rpx; }
.bs__info { flex: 1; min-width: 0; }
.bs__name { font-weight: 600; font-size: 32rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bs__meta { margin-top: 12rpx; }
.bs__check { width: 44rpx; height: 44rpx; flex-shrink: 0; }
.bs__row.sel .bs__name { color: var(--accent-ink); }

.bs__manage {
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
  padding: 30rpx; margin-top: 8rpx; flex-shrink: 0;
  border-top: 1rpx solid var(--border);
  color: var(--muted); font-size: 28rpx;
}
.bs__manage image { width: 28rpx; height: 28rpx; }
.bs__manage--press { background: rgba(62, 69, 80, 0.05); }
