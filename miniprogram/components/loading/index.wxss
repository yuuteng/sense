.loading {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 500;
  background: #f6f9fc;          /* 兜底不透明底，防 CSS 变量未级联时透出内容 */
  background: var(--bg);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24rpx;
}
.loading__spin {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  border: 6rpx solid rgba(0, 204, 249, 0.20);
  border-top-color: var(--accent);
  animation: loading-spin 0.8s linear infinite;
}
.loading__text { color: var(--muted); font-size: 26rpx; }
@keyframes loading-spin { to { transform: rotate(360deg); } }
