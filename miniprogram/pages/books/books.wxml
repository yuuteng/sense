<view class="screen" style="padding-bottom:48rpx">
  <nav-bar back="{{true}}" title="账本管理" center="{{true}}">
    <view slot="right" class="appbar__btn" hover-class="active" hover-stay-time="80" bindtap="goNewBook">
      <image src="{{ic.plus}}" style="width:48rpx;height:48rpx"></image>
    </view>
  </nav-bar>

  <view class="section-label">我的账本 · {{books.length}} 个</view>
  <view wx:for="{{books}}" wx:key="bookId" class="group group--flat">
    <view class="li" style="align-items:flex-start;padding-top:32rpx;padding-bottom:32rpx" hover-class="pressed" hover-stay-time="80" data-id="{{item.bookId}}" bindtap="openBook">
      <view class="li__ic" style="width:76rpx;height:76rpx;background:{{item.iconBg}}"><image src="{{item.iconSrc}}" style="width:40rpx;height:40rpx"></image></view>
      <view style="flex:1;min-width:0">
        <!-- 层级：名字（主角）+ 默认徽章（唯一高亮）；类型/角色是低频 meta，纯文字不抢 -->
        <view style="font-weight:600;display:flex;align-items:center;gap:16rpx">
          <text class="ellip" style="max-width:360rpx">{{item.name}}</text>
          <text wx:if="{{item.isCurrent}}" class="pill pill--accent" style="flex-shrink:0">默认</text>
        </view>
        <view class="muted" style="font-size:24rpx;margin-top:8rpx">{{item.typeLabel}} · {{item.roleMine}}</view>
      </view>
      <image class="chevron" src="{{ic.chevron}}"></image>
    </view>
  </view>

  <view class="foot-note left">点任意账本进入设置：管理成员、编辑信息、改我的名字、解散账本等。</view>
</view>
