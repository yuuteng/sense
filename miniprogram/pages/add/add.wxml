<view class="screen {{type==='in' ? 'mode-income' : ''}}">
  <loading show="{{loading}}"></loading>
  <nav-bar back="{{true}}" center="{{true}}" title="{{navTitle}}" sub="{{book.name}}"></nav-bar>

  <!-- 收支切换 -->
  <view style="padding:0 40rpx">
    <view class="segmented">
      <view class="segmented__btn {{type==='out'?'selected':''}}" data-k="out" bindtap="switchType">支出</view>
      <view class="segmented__btn {{type==='in'?'selected':''}}" data-k="in" bindtap="switchType">收入</view>
    </view>
  </view>

  <!-- 金额（系统数字键盘）+ 币种 -->
  <view class="amount-display">
    <view class="amount-line">
      <text class="cur">{{curs[curIndex].symbol}}</text>
      <input class="amount-input" type="digit" value="{{amount}}" placeholder="0" placeholder-class="input-ph" bindinput="onAmountInput" focus="{{amountFocus}}" />
    </view>
    <view class="fx-hint">{{fxHint}}</view>
    <view class="cur-pick" hover-class="pressed" hover-stay-time="80" bindtap="openCur">{{curLabel}} <image class="chevron" src="{{ic.chevron}}"></image></view>
  </view>

  <!-- 一级分类九宫格（末尾可添加）-->
  <view class="cat-grid">
    <view wx:for="{{cats}}" wx:key="id" class="cat {{catIndex===index?'selected':''}}" data-i="{{index}}" bindtap="pickCat" bindlongpress="onDeleteCat">
      <view class="cat__ic"><image src="{{catIndex===index?item.iconOn:item.iconOff}}"></image></view>
      <text>{{item.key}}</text>
    </view>
    <view class="cat" bindtap="onAddCat">
      <view class="cat__ic cat__ic--add"><image src="{{ic.plus}}"></image></view>
      <text>添加</text>
    </view>
  </view>

  <!-- 二级分类（末尾可添加）-->
  <view class="subcats">
    <view wx:for="{{subs}}" wx:key="categoryId" class="chip {{subIndex===index?'selected':''}}" data-i="{{index}}" bindtap="pickSub" bindlongpress="onDeleteSub">{{item.name}}</view>
    <view class="chip chip--add" bindtap="onAddSub">＋ 添加</view>
  </view>

  <!-- 一次性提示：长按手势不可见，首次进入明说（PRD 6「识别而非回忆」）-->
  <view wx:if="{{catHint}}" class="cat-hint">
    <text>长按分类可停用（历史记录不受影响）</text>
    <text class="cat-hint__ok" bindtap="dismissCatHint">知道了</text>
  </view>

  <!-- 付款人（仅分账账本）-->
  <block wx:if="{{isSplit}}">
  <view class="section-label" style="padding-bottom:16rpx">付款人 <text class="muted" style="font-weight:400">谁先垫付了这笔</text></view>
  <view class="member-row">
    <view wx:for="{{members}}" wx:key="openid" class="member-pick {{payerIndex===index?'selected':''}}" data-i="{{index}}" bindtap="pickPayer">
      <avatar src="{{item.avatarFileID}}" initial="{{item.initial}}" color="{{item.color}}" size="52"></avatar><text class="ellip">{{item.name}}</text>
    </view>
  </view>

  <view class="section-label" style="padding-bottom:16rpx">分摊方式</view>
  <view style="padding:0 40rpx 24rpx">
    <view class="segmented">
      <view wx:for="{{splitModes}}" wx:key="k" class="segmented__btn {{splitMode===item.k?'selected':''}}" data-k="{{item.k}}" bindtap="switchSplitMode">{{item.label}}</view>
    </view>
  </view>
  <view class="member-row" style="{{splitMode==='treat'?'opacity:0.45':''}}">
    <view wx:for="{{splitMembers}}" wx:key="openid" class="member-pick {{item.selected?'selected':''}}" data-i="{{index}}" bindtap="toggleSplitMember">
      <avatar src="{{item.avatarFileID}}" initial="{{item.initial}}" color="{{item.color}}" size="52"></avatar><text class="ellip">{{item.name}}</text>
    </view>
  </view>
  <view class="foot-note left" style="padding-top:0;padding-bottom:8rpx">{{splitHint}}</view>
  </block>

  <!-- 备注 / 日期 -->
  <view class="card--flush" style="margin:0 40rpx">
    <view class="field-row">
      <view class="field-row__label"><image src="{{ic.note}}"></image>备注</view>
      <view class="field-row__val"><input placeholder="添加备注…" placeholder-class="input-ph" value="{{note}}" bindinput="onNoteInput" /></view>
    </view>
    <view class="field-row" hover-class="pressed" hover-stay-time="80" bindtap="openCalendar">
      <view class="field-row__label"><image src="{{ic.calendar}}"></image>日期</view>
      <view class="field-row__val">{{dateLabel}} <image class="chevron" src="{{ic.chevron}}"></image></view>
    </view>
  </view>

  <!-- 图片附件 -->
  <view class="photo-strip">
    <view wx:for="{{photos}}" wx:key="*this" class="photo-thumb" style="background:none">
      <image src="{{item}}" style="width:100%;height:100%;border-radius:var(--radius-sm)" mode="aspectFill"></image>
      <text class="x" data-i="{{index}}" catchtap="removePhoto">×</text>
    </view>
    <view wx:if="{{photos.length < 9}}" class="photo-add" bindtap="choosePhoto"><image src="{{ic.photoAdd}}"></image></view>
  </view>

  <view style="padding:40rpx 40rpx calc(60rpx + env(safe-area-inset-bottom))">
    <view class="btn btn--primary btn--block btn--lg" hover-class="pressed" hover-stay-time="80" bindtap="save">{{editId ? '保存修改' : '保存'}}</view>
  </view>

  <calendar visible="{{calVisible}}" value="{{date}}" bind:pick="onCalPick" bind:close="onCalClose"></calendar>
  <currency-picker visible="{{curVisible}}" current="{{curs[curIndex].code}}" bind:select="onCur" bind:close="closeCur"></currency-picker>

  <!-- 新增一级分类弹层 -->
  <view wx:if="{{addCat.visible}}" class="addcat-mask" bindtap="cancelAddCat">
    <view class="addcat" catchtap="noop">
      <view class="addcat__title">新增一级分类</view>
      <input class="text-input" placeholder="分类名称" placeholder-class="input-ph" value="{{addCat.name}}" bindinput="onAddCatName" focus />
      <view class="addcat__label">选择图标</view>
      <view class="addcat__icons">
        <view
          wx:for="{{iconOptions}}"
          wx:key="name"
          class="addcat__ic {{addCat.iconIndex===index ? 'sel' : ''}}"
          data-i="{{index}}"
          bindtap="pickAddIcon"
        >
          <image src="{{addCat.iconIndex===index ? item.on : item.off}}"></image>
        </view>
      </view>
      <view class="addcat__foot">
        <view class="btn btn--ghost" style="flex:1" hover-class="pressed" hover-stay-time="80" bindtap="cancelAddCat">取消</view>
        <view class="btn btn--primary" style="flex:1" hover-class="pressed" hover-stay-time="80" bindtap="confirmAddCat">添加</view>
      </view>
    </view>
  </view>
</view>
