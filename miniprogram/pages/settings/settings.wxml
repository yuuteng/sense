<view class="screen screen--pad">
  <loading show="{{loading}}"></loading>
  <nav-bar title="我的"></nav-bar>

  <!-- 个人头（点击改昵称）-->
  <view class="li" style="margin:0 40rpx 40rpx;border-radius:var(--radius-md);padding:32rpx" hover-class="pressed" hover-stay-time="80" bindtap="editProfile">
    <image wx:if="{{profile.avatarFileID}}" src="{{profile.avatarFileID}}" style="width:96rpx;height:96rpx;border-radius:50%" mode="aspectFill"></image>
    <text wx:else class="avatar" style="background:{{profile.avatarColor}};width:96rpx;height:96rpx;font-size:36rpx">{{profile.avatarInitial}}</text>
    <view class="li__label">{{profile.nickname || '未登录'}}<view class="li__val">已加入 {{profile.bookCount}} 个账本{{profile.defaultBookName ? ' · 默认「' + profile.defaultBookName + '」' : ''}}</view></view>
    <image class="chevron" src="{{ic.chevron}}"></image>
  </view>

  <view class="group__title">偏好</view>
  <view class="group group--flat">
    <view class="li" hover-class="pressed" hover-stay-time="80" bindtap="openCur">
      <view class="li__ic"><image src="{{ic.currency}}"></image></view>
      <view class="li__label">展示币种</view>
      <view class="li__val">{{curLabel}} <image class="chevron" src="{{ic.chevron}}"></image></view>
    </view>
    <view class="li">
      <view class="li__ic"><image src="{{ic.aiBox}}"></image></view>
      <view class="li__label">AI 会话保留上限</view>
      <view class="li__val num">{{aiLimit}} 条</view>
    </view>
  </view>

  <view class="group__title">账本与数据</view>
  <view class="group group--flat">
    <view class="li" hover-class="pressed" hover-stay-time="80" bindtap="goBooks">
      <view class="li__ic"><image src="{{ic.book}}"></image></view>
      <view class="li__label">账本管理</view>
      <view class="li__val">{{profile.bookCount}} 个 <image class="chevron" src="{{ic.chevron}}"></image></view>
    </view>
    <view class="li" hover-class="pressed" hover-stay-time="80" bindtap="onExport">
      <view class="li__ic"><image src="{{ic.download}}"></image></view>
      <view class="li__label">导出数据</view>
      <view class="li__val">账本 / 时间 / 格式 <image class="chevron" src="{{ic.chevron}}"></image></view>
    </view>
    <view class="li" hover-class="pressed" hover-stay-time="80" bindtap="onImport">
      <view class="li__ic"><image src="{{ic.upload}}"></image></view>
      <view class="li__label">导入数据</view>
      <view class="li__val">{{importVal}}</view>
    </view>
  </view>

  <block wx:if="{{profile.isDev}}">
  <view class="group__title">开发（dev）</view>
  <view class="group group--flat">
    <view class="li" hover-class="pressed" hover-stay-time="80" bindtap="refreshRates">
      <view class="li__ic"><image src="{{ic.refresh}}"></image></view>
      <view class="li__label">刷新汇率</view>
      <view class="li__val">从开放源拉取 <image class="chevron" src="{{ic.chevron}}"></image></view>
    </view>
    <view class="li" hover-class="pressed" hover-stay-time="80" bindtap="initSeed">
      <view class="li__ic"><image src="{{ic.seed}}"></image></view>
      <view class="li__label">初始化测试数据</view>
      <view class="li__val">载入演示数据 <image class="chevron" src="{{ic.chevron}}"></image></view>
    </view>
    <view class="li" hover-class="pressed" hover-stay-time="80" bindtap="resetData">
      <view class="li__ic danger"><image src="{{ic.wipe}}"></image></view>
      <view class="li__label" style="color:var(--danger)">清空所有数据</view>
    </view>
  </view>
  </block>

  <view class="group__title">关于</view>
  <view class="group group--flat">
    <view class="li"><view class="li__label">隐私说明</view><view class="li__val">AI 分析基于你的账本数据</view></view>
    <view class="li"><view class="li__label">版本</view><view class="li__val num">v1.0 · P1</view></view>
  </view>

  <currency-picker visible="{{curVisible}}" current="{{curCode}}" bind:select="onCur" bind:close="closeCur"></currency-picker>
</view>
