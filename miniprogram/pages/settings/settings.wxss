/* settings 页面样式继承自 app.wxss；以下为导入结果面板 */

/* 个人头副行：默认账本单独一行，过长省略 */
.li__val--sub { margin-top: 2rpx; display: block; max-width: 420rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* 头像选择：头像用普通 view 排版；button（open-type=chooseAvatar）做绝对定位透明覆盖层。
   原生 button 宽度不可控（参见 bookConfig .invite-btn 同类问题），放进 flex 流会挤坏行布局。 */
.avatar-wrap { position: relative; width: 96rpx; height: 96rpx; flex-shrink: 0; }
.avatar-choose {
  position: absolute; left: 0; top: 0; width: 100%; height: 100%;
  margin: 0; padding: 0; background: transparent; border: none; border-radius: 50%; line-height: normal;
}
.avatar-choose::after { border: none; }

.imp-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 100;
  background: rgba(20, 30, 40, 0.45);
  display: flex; align-items: flex-end;
}
.imp-sheet {
  width: 100%; box-sizing: border-box;
  background: var(--bg); border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  max-height: 78vh; display: flex; flex-direction: column;
}

.imp-head { display: flex; align-items: center; gap: 20rpx; }
.imp-badge {
  width: 64rpx; height: 64rpx; border-radius: 50%; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; font-weight: 700; color: #fff;
}
.imp-badge--ok { background: var(--success); color: #2c4a00; }
.imp-badge--warn { background: var(--warn); color: #5c4a00; }
.imp-title { font-size: var(--text-lg); font-weight: 700; }
.imp-time { font-size: var(--text-xs); color: var(--muted); margin-top: 4rpx; }

.imp-nums {
  display: flex; margin-top: 32rpx; padding: 24rpx 0;
  background: var(--surface); border-radius: var(--radius-md); box-shadow: var(--shadow-soft);
}
.imp-num { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.imp-num__v { font-size: 44rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.imp-num__v.ok { color: var(--success-strong); }
.imp-num__v.bad { color: var(--danger-ink); }
.imp-num__k { font-size: var(--text-xs); color: var(--muted); }

.imp-sec {
  font-size: var(--text-xs); font-weight: 600; color: var(--muted);
  padding: 20rpx 28rpx 8rpx; background: var(--surface);
}
.imp-copy-link { text-align: center; font-size: var(--text-xs); color: var(--muted); padding-top: 22rpx; }
.imp-list {
  flex: 1; min-height: 0; max-height: 40vh;
  background: var(--surface); border-radius: var(--radius-md); box-shadow: var(--shadow-soft);
}
.imp-row { padding: 22rpx 28rpx; border-bottom: 1rpx solid var(--border); }
.imp-row:last-child { border-bottom: none; }
.imp-row__where { font-size: var(--text-sm); font-weight: 600; }
.imp-row__sum { font-weight: 400; color: var(--muted); margin-left: 14rpx; font-size: var(--text-xs); }
.imp-row__reason { font-size: var(--text-xs); color: var(--danger-ink); margin-top: 6rpx; }

.imp-foot-note { font-size: 22rpx; color: var(--muted); margin-top: 14rpx; }
.imp-actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
