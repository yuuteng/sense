.join { min-height: 100vh; display: flex; flex-direction: column; }
.join__box { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 0 56rpx 160rpx; }
.join__logo { width: 140rpx; height: 140rpx; border-radius: 32rpx; }
.join__title { font-size: 40rpx; font-weight: 600; margin-top: 40rpx; }
.join__sub { color: var(--muted); font-size: 30rpx; margin-top: 12rpx; }
