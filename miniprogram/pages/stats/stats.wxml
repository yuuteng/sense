<view class="screen screen--pad">
  <loading show="{{loading}}"></loading>
  <nav-bar center="{{true}}" title="统计" sub="{{navSub}}">
    <view
      slot="right"
      class="appbar__btn {{editing?'active':''}}"
      hover-class="active"
      hover-stay-time="80"
      bindtap="toggleEdit"
    >
      <image src="{{editIcon}}" style="width:44rpx;height:44rpx"></image>
    </view>
  </nav-bar>

  <view wx:if="{{needInit}}" style="text-align:center;padding:120rpx 60rpx">
    <view style="font-size:32rpx;font-weight:600">还没有账本</view>
    <view class="muted" style="font-size:28rpx;margin-top:12rpx">创建账本并记账后，这里会显示统计图表。</view>
  </view>

  <view wx:else id="cards" bindtouchmove="onListTouchMove" bindtouchend="onHandleTouchEnd">
    <view
      wx:for="{{cards}}"
      wx:key="id"
      wx:for-item="card"
      class="chart-card {{editing?'editing':''}} {{draggingId===card.id?'dragging':''}}"
    >
      <view class="chart-card__del" data-id="{{card.id}}" catchtap="removeCard">×</view>

      <view class="chart-card__head" bindlongpress="onLongPress">
        <view>
          <view class="chart-card__title">{{card.title}}</view>
          <view class="chart-card__sub">{{card.sub}}</view>
        </view>
        <view
          class="drag-handle"
          data-id="{{card.id}}"
          catchtouchstart="onHandleTouchStart"
          catchtouchend="onHandleTouchEnd"
        >
          <image src="{{dragIcon}}"></image>
        </view>
      </view>

      <!-- 区间选择 -->
      <view wx:if="{{card.range==='week'}}" class="range-chips">
        <text class="rchip {{weekDays===7?'on':''}}" data-d="7" bindtap="setWeekRange">近 7 日</text>
        <text class="rchip {{weekDays===14?'on':''}}" data-d="14" bindtap="setWeekRange">近 14 日</text>
        <text class="rchip {{weekDays===30?'on':''}}" data-d="30" bindtap="setWeekRange">近 30 日</text>
      </view>
      <view wx:elif="{{card.range==='year'}}" class="range-chips">
        <text class="rchip {{yearMonths===6?'on':''}}" data-m="6" bindtap="setYearRange">近 6 月</text>
        <text class="rchip {{yearMonths===12?'on':''}}" data-m="12" bindtap="setYearRange">近 12 月</text>
      </view>

      <!-- 饼图 -->
      <view wx:if="{{card.kind==='pie'}}" class="pie-wrap">
        <image class="donut" src="{{card.svg}}"></image>
        <view class="pie-legend">
          <view wx:for="{{card.legends}}" wx:key="k" wx:for-item="lg" class="pl-item">
            <text wx:if="{{lg.dot}}" class="pl-dot" style="background:{{lg.dot}}"></text>
            <text class="pl-k">{{lg.k}}</text>
            <text class="pl-v num {{lg.strong?'strong':''}}">{{lg.v}}</text>
          </view>
        </view>
      </view>

      <!-- 柱状 / 分组柱状 -->
      <block wx:else>
        <image class="chart-svg" src="{{card.svg}}" mode="widthFix"></image>
        <view class="legend">
          <view wx:for="{{card.legends}}" wx:key="k" wx:for-item="lg" class="item">
            <text wx:if="{{lg.dot}}" class="dot" style="background:{{lg.dot}}"></text>{{lg.k}}
          </view>
        </view>
      </block>
    </view>

    <!-- 添加图表 -->
    <view wx:if="{{canAdd}}" class="add-card" hover-class="pressed" hover-stay-time="80" bindtap="addChart">
      <image src="{{addIcon}}"></image>
      <text>添加图表</text>
    </view>

    <view wx:if="{{editing && cards.length}}" class="ai-disclaimer">编辑模式 · 拖右侧手柄排序，点左上角 × 移除，自动保存</view>

    <view wx:if="{{!cards.length}}" style="text-align:center;padding:112rpx 60rpx">
      <image src="{{barsIcon}}" style="width:88rpx;height:88rpx;margin:0 auto"></image>
      <view style="font-size:32rpx;font-weight:600;margin-top:28rpx">还没有图表卡片</view>
      <view class="muted" style="font-size:28rpx;margin-top:8rpx">你移除了全部卡片，可一键恢复四个默认图表。</view>
      <view class="btn btn--primary" style="margin-top:36rpx;display:inline-flex" hover-class="pressed" hover-stay-time="80" bindtap="restoreDefault">恢复默认图表</view>
    </view>
  </view>
</view>
