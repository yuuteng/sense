/* 统计页专属样式（基础图表卡样式在 app.wxss） */

/* 月份切换（月度类卡片）：‹ 2026年7月 › */
.month-nav { display: inline-flex; align-items: center; gap: 4rpx; margin-bottom: var(--space-3); }
/* 可见圆 56rpx，透明 border 把命中区扩到 88rpx（≥44pt） */
.mnav__btn {
  width: 88rpx; height: 88rpx; border: 16rpx solid transparent; background-clip: padding-box;
  border-radius: var(--radius-pill);
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; line-height: 1; color: var(--accent-ink);
  background-color: rgba(0,204,249,0.10);
}
.mnav__btn.off { color: var(--muted); background: rgba(62,69,80,0.04); opacity: 0.5; }
.mnav__btn--press { background: rgba(0,204,249,0.20); }
.mnav__label {
  min-width: 220rpx; text-align: center;
  padding: 10rpx 24rpx; border-radius: var(--radius-pill);
  font-size: 26rpx; font-weight: 600; color: var(--accent-ink);
  background: rgba(0,204,249,0.10);
}
.mnav__label--press { background: rgba(0,204,249,0.20); }

/* 区间选择 chips */
.range-chips { display: flex; gap: 12rpx; margin-bottom: var(--space-3); flex-wrap: wrap; }
.rchip {
  padding: 14rpx 22rpx; border-radius: var(--radius-pill); /* 加高命中区（双排紧邻，不用透明 border 防串行误触） */
  font-size: 24rpx; font-weight: 600; color: var(--muted);
  background: rgba(62,69,80,0.05);
}
.rchip.on { background: rgba(0,204,249,0.14); color: var(--accent-ink); }

/* 饼图 */
.pie-wrap { display: flex; align-items: center; gap: var(--space-4); padding: var(--space-2) 0; }
.donut { width: 220rpx; height: 220rpx; flex-shrink: 0; }
.pie-legend { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 18rpx; }
.pl-item { display: flex; align-items: center; gap: 14rpx; font-size: var(--text-sm); }
/* 标签「收入/支出/结余」永不换行；巨额金额单行省略，不许把标签挤成竖排 */
.pl-item .pl-k { flex-shrink: 0; white-space: nowrap; }
.pl-item .pl-v { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pl-dot { width: 16rpx; height: 16rpx; border-radius: 50%; flex-shrink: 0; }
.pl-k { color: var(--muted); }
.pl-v { margin-left: auto; font-weight: 600; }
.pl-v.strong { font-size: var(--text-base); color: var(--fg); }

/* 钻取通用：图例行可点箭头 + 柱状图两段式入口条 */
.pl-item--press, .pl-item--link:active { opacity: 0.72; }
/* 扇区点击联动：对应图例行凸显（负 margin 保持左右对齐不跳动） */
.pl-item--hl {
  background: rgba(0,204,249,0.10);
  border-radius: 12rpx;
  padding: 8rpx 14rpx; margin: -8rpx -14rpx;
}
.pl-item--hl .pl-k { color: var(--fg); font-weight: 600; }
.pl-go { color: var(--muted); font-size: 26rpx; margin-left: 4rpx; }
.drill-bar {
  display: flex; align-items: center; justify-content: space-between; gap: 16rpx;
  margin-top: var(--space-2);
  padding: 18rpx 26rpx;
  border-radius: var(--radius-sm);
  background: rgba(0, 204, 249, 0.08);
  animation: drill-in 220ms cubic-bezier(0.16, 1, 0.3, 1);
}
.drill-bar--press { background: rgba(0, 204, 249, 0.16); }
/* 明细入口三段式：左=日期/月份（垂直居中），中=数值上下堆叠（收/支各一行），右=查看明细 */
.drill-bar__label {
  flex-shrink: 0;
  font-size: 26rpx; font-weight: 600;
  white-space: nowrap;
}
.drill-bar__vals {
  flex: 1; min-width: 0;
  display: flex; flex-direction: column; gap: 6rpx;
  font-size: 26rpx; font-weight: 600;
}
.drill-bar__vals text { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.drill-bar__go { flex-shrink: 0; color: var(--accent-ink); font-size: 26rpx; font-weight: 600; }
@keyframes drill-in { from { opacity: 0; transform: translateY(-8rpx); } to { opacity: 1; transform: translateY(0); } }

/* 分类占比卡：居中环形 + 中心总额 + 排行列表 */
.cat-donut { position: relative; width: 300rpx; margin: 8rpx auto 0; }
.cat-donut__center {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  pointer-events: none;
}
.cat-donut__center .k { font-size: 22rpx; color: var(--muted); }
/* 巨额月份不许溢出环外 */
.cat-donut__center .v { font-size: 30rpx; font-weight: 700; margin-top: 4rpx; max-width: 220rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cat-rank { margin-top: var(--space-3); }
.cat-row { display: flex; align-items: center; gap: 14rpx; padding: 18rpx 8rpx; }
.cat-row + .cat-row { border-top: 1rpx solid var(--border); }
.cat-row.pressed { background: rgba(62,69,80,0.04); }
.cat-row.hl { background: rgba(0,204,249,0.06); }
.cat-row__dot { width: 16rpx; height: 16rpx; border-radius: 50%; flex-shrink: 0; }
.cat-row__name { flex: 1; font-size: 28rpx; font-weight: 500; }
.cat-row__count { color: var(--muted); font-size: 22rpx; flex-shrink: 0; }
.cat-row__amt { font-weight: 600; font-size: 28rpx; flex-shrink: 0; }
.cat-row__pct { color: var(--muted); font-size: 22rpx; width: 84rpx; text-align: right; flex-shrink: 0; }
.cat-more { text-align: center; padding: 20rpx; color: var(--accent-ink); font-size: 26rpx; font-weight: 600; }
.cat-more.pressed { opacity: 0.7; }

/* 成员对比卡：头像 + 名字 + 比例条（CVD 安全：成员靠头像/名字区分，不靠色相；「我」加深） */
.mb-list { margin-top: 4rpx; }
.mb-row { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 8rpx; }
.mb-row + .mb-row { border-top: 1rpx solid var(--border); }
.mb-row.pressed { background: rgba(62,69,80,0.04); }
.mb-row__main { flex: 1; min-width: 0; }
.mb-row__top { display: flex; align-items: baseline; gap: 12rpx; }
.mb-row__name { font-size: 28rpx; font-weight: 500; max-width: 220rpx; }
.mb-row__name--me { font-weight: 600; }
.mb-row__count { color: var(--muted); font-size: 22rpx; flex-shrink: 0; }
.mb-row__amt { margin-left: auto; font-weight: 600; font-size: 28rpx; flex-shrink: 0; }
.mb-row__pct { color: var(--muted); font-size: 22rpx; width: 84rpx; text-align: right; flex-shrink: 0; }
.mb-bar { margin-top: 10rpx; height: 14rpx; border-radius: 999rpx; background: rgba(62,69,80,0.05); overflow: hidden; }
.mb-bar__fill { height: 100%; border-radius: 999rpx; background: rgba(0,204,249,0.45); transition: width 240ms cubic-bezier(0.22,0.61,0.36,1); }
.mb-bar__fill--me { background: var(--blue-600); }
.mb-total { text-align: right; padding: 16rpx 8rpx 4rpx; font-size: 24rpx; color: var(--muted); }

/* 分区标题右侧动作组：＋添加 / 编辑 */
.sec-actions { display: flex; align-items: center; gap: 32rpx; }

/* 编辑模式：整张卡片拖拽排序 */
.chart-card--edit {
  border-style: dashed;
  border-color: rgba(0,137,192,0.45);
  transition: transform 0.18s ease; /* 让位动画 */
}
.chart-card--drag {
  transition: none; /* 拖动中的卡跟手，不做过渡 */
  z-index: 6;
  border-style: solid;
  border-color: var(--accent-ink);
  box-shadow: 0 20rpx 48rpx rgba(0,137,192,0.25);
}
.chart-card__grip { width: 44rpx; height: 44rpx; flex-shrink: 0; }
/* 删除角标：可见圆 52rpx，透明 border 扩命中区到 88rpx（≥44pt） */
.card-x {
  position: absolute; top: -32rpx; right: -32rpx; z-index: 7;
  width: 88rpx; height: 88rpx; border: 18rpx solid transparent; background-clip: padding-box;
  border-radius: 50%;
  background-color: var(--danger); color: #ffffff;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(246,33,114,0.35);
}
.card-x--press { transform: scale(0.92); }

/* 图表 SVG（柱状/分组柱状） */
.chart-svg { width: 100%; height: auto; display: block; margin-top: var(--space-2); }

/* 添加图表卡 */
.add-card {
  margin: 0 var(--space-5) var(--space-4);
  padding: var(--space-5);
  border: 2rpx dashed var(--border); border-radius: var(--radius-md);
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  color: var(--accent-ink); font-size: var(--text-sm); font-weight: 600;
  background: rgba(0,204,249,0.04);
}
.add-card image { width: 34rpx; height: 34rpx; }
.add-card.pressed { transform: scale(0.98); background: rgba(0,204,249,0.08); }

/* 添加图表选择面板（底部弹层 + 示意图） */
.cpk-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 300;
  background: rgba(62,69,80,0); transition: background 300ms ease;
  display: flex; align-items: flex-end;
}
.cpk-mask--show { background: rgba(62,69,80,0.45); }
.cpk {
  width: 100%; background: var(--surface);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  /* 固定高度：scroll-view 只有拿到「确定高度」才会真正滚动（flex 压出的高度在部分基础库上失效） */
  height: 78vh; box-sizing: border-box;
  display: flex; flex-direction: column;
  transform: translateY(101%);
  transition: transform 340ms cubic-bezier(0.16,1,0.3,1);
  will-change: transform;
}
.cpk--up { transform: translateY(0); }
.cpk__grab { width: 72rpx; height: 8rpx; border-radius: 999rpx; background: var(--border); margin: 16rpx auto 0; flex-shrink: 0; }
.cpk__title { text-align: center; font-size: var(--text-lg); font-weight: 600; padding: 20rpx 32rpx 8rpx; flex-shrink: 0; }
.cpk__hint { text-align: center; color: var(--muted); font-size: 24rpx; padding: 0 40rpx 20rpx; flex-shrink: 0; }
/* scroll-view 承载（view 的 overflow-y:auto 在真机不可滚动）：
   父容器 .cpk 固定高度 → flex:1 + height:0 给出确定高度，内容超出即可滚 */
.cpk__list { flex: 1; height: 0; min-height: 0; padding: 0 24rpx 8rpx; box-sizing: border-box; }

/* 面板分组标题（环形/柱状/折线） */
.cpk__sec {
  padding: 24rpx 16rpx 8rpx;
  font-size: 24rpx; font-weight: 600; color: var(--muted);
}
.cpk__row {
  display: flex; align-items: center; gap: var(--space-4);
  padding: 20rpx 16rpx; border-radius: var(--radius-md);
}
.cpk__row + .cpk__row { border-top: 1rpx solid var(--border); }
.cpk__row--press { background: rgba(62,69,80,0.05); }
.cpk__thumb {
  width: 168rpx; height: 120rpx; flex-shrink: 0;
  border-radius: var(--radius-sm); background: rgba(62,69,80,0.04);
  display: flex; align-items: center; justify-content: center;
}
.cpk__thumb image { width: 100%; height: 100%; }
.cpk__thumb--pie image { width: 120rpx; height: 120rpx; }
.cpk__info { flex: 1; min-width: 0; }
.cpk__t { font-weight: 600; font-size: 32rpx; }
.cpk__d { color: var(--muted); font-size: 26rpx; margin-top: 8rpx; }
.cpk__plus { width: 40rpx; height: 40rpx; flex-shrink: 0; }
