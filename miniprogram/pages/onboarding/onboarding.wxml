<view class="screen">
  <view class="status-spacer" style="height:{{statusBarHeight}}px"></view>

  <!-- 品牌：左上角 -->
  <view class="onboard__brand">
    <image class="brand-mark" src="/brand/icon.png"></image>
    <view>
      <view class="onboard__name">心数 <text class="muted" style="font-weight:400">Sense</text></view>
      <view class="onboard__tag">记得轻松，算得清楚</view>
    </view>
  </view>

  <!-- 表单：大标题压顶 + 表单 -->
  <view class="onboard">
    <view class="onboard__head">
      <view class="onboard__h1">创建你的账本</view>
      <view class="onboard__sub">选择类型与统计币种，随后即可开始记账</view>
    </view>

    <view class="input-label">账本名称</view>
    <input class="text-input" placeholder="例如：家庭日常" value="{{bookName}}" bindinput="onNameInput" />

    <view class="input-label">账本类型</view>
    <view class="type-choice">
      <view class="type-card {{type==='share'?'selected':''}}" data-t="share" bindtap="pickType">
        <view class="h3">共享账本 <view class="radio-mark"></view></view>
        <view class="type-card__p">多人协作记账，账目公开透明</view>
      </view>
      <view class="type-card {{type==='split'?'selected':''}}" data-t="split" bindtap="pickType">
        <view class="h3">分账账本 <view class="radio-mark"></view></view>
        <view class="type-card__p">记录付款与分摊，适合 AA / 合租 / 旅行</view>
      </view>
    </view>

    <view class="input-label">统计币种</view>
    <view class="text-input text-input--row" hover-class="pressed" hover-stay-time="80" bindtap="openCur">
      <text>{{curLabel}}</text>
      <image class="chevron" src="{{chevron}}"></image>
    </view>
  </view>

  <currency-picker visible="{{curVisible}}" current="{{baseCur}}" bind:select="onCur" bind:close="closeCur"></currency-picker>

  <view class="action-bar">
    <view class="btn btn--primary btn--block btn--lg" hover-class="pressed" hover-stay-time="80" bindtap="create">创建账本</view>
  </view>
</view>
