<view class="screen" style="padding-bottom:48rpx">
  <loading show="{{loading}}"></loading>
  <nav-bar back="{{true}}" center="{{true}}" title="账本设置"></nav-bar>

  <block wx:if="{{book}}">
    <!-- 账本信息：名称置顶，可点改名（管理员）；类型/角色/默认在其下 -->
    <view class="section-label">账本信息</view>
    <view class="group group--flat">
      <view wx:if="{{canManage}}" class="li" hover-class="pressed" hover-stay-time="80" bindtap="editBookName">
        <view class="li__label">账本名称</view>
        <view class="li__val ellip">{{book.name}} <image class="chevron" src="{{ic.pencil}}"></image></view>
      </view>
      <view wx:else class="li">
        <view class="li__label">账本名称</view>
        <view class="li__val ellip">{{book.name}}</view>
      </view>
      <view class="li">
        <view class="li__label">账本类型</view>
        <view class="li__val">{{book.typeLabel}}</view>
      </view>
      <view class="li">
        <view class="li__label">我的角色</view>
        <view class="li__val">{{roleLabel}}</view>
      </view>
      <view class="li">
        <view class="li__label">默认账本</view>
        <view wx:if="{{book.isDefault}}" class="li__val">当前默认</view>
        <view wx:else class="btn btn--mini set-default" hover-class="pressed" hover-stay-time="80" catchtap="setDefault">设为默认</view>
      </view>
    </view>

    <!-- 成员 -->
    <view class="section-label section-label--row">
      <text>成员 · {{members.length}} 人</text>
      <view wx:if="{{canManage}}" class="invite-btn" hover-class="invite-btn--h" hover-stay-time="80" bindtap="openInvite">
        <view class="invite-pill"><image src="{{ic.plus}}"></image><text>邀请成员</text></view>
      </view>
    </view>
    <view class="group group--flat">
      <view wx:for="{{members}}" wx:key="openid" class="li" data-i="{{index}}" hover-class="pressed" hover-stay-time="80" bindtap="onTapMember">
        <avatar src="{{item.avatarFileID}}" initial="{{item.initial}}" color="{{item.color}}" size="68"></avatar>
        <view class="li__label ellip">{{item.name}}</view>
        <text class="role {{item.roleClass}}">{{item.roleBadge}}</text>
        <image wx:if="{{canManage && !item.isMe && item.role!=='owner'}}" class="chevron" src="{{ic.chevron}}"></image>
      </view>
    </view>
    <view wx:if="{{canManage}}" class="ai-disclaimer left">点成员可改权限或移除；邀请通过微信分享卡片，好友点开即加入。Admin 不能移除 Owner 或其他 Admin。</view>

    <!-- 操作 -->
    <block wx:if="{{isSplit || isOwner}}">
      <view class="section-label">操作</view>
      <view class="group group--flat">
        <view wx:if="{{isSplit}}" class="li" hover-class="pressed" hover-stay-time="80" bindtap="goSettle">
          <view class="li__ic"><image src="{{ic.arrow}}"></image></view>
          <view class="li__label">分账结算</view>
          <image class="chevron" src="{{ic.chevron}}"></image>
        </view>
        <view wx:if="{{isOwner}}" class="li" hover-class="pressed" hover-stay-time="80" bindtap="onDissolve">
          <view class="li__ic danger"><image src="{{ic.trash}}"></image></view>
          <view class="li__label" style="color:var(--danger)">{{dissolveText}}</view>
        </view>
      </view>
    </block>
  </block>

  <!-- 邀请成员：先选权限，再由分享按钮直接拉起微信分享（分享必须由用户点击 open-type=share 触发） -->
  <view wx:if="{{inviteVisible}}" class="inv-mask" bindtap="closeInvite" catchtouchmove="noop">
    <view class="inv-sheet" catchtap="noop">
      <view class="inv-title">邀请成员</view>
      <view class="inv-hint">选择新成员加入后的权限，随后转发邀请卡片给好友；加入后可在成员列表随时调整。</view>
      <button class="inv-btn" open-type="share" data-role="rw" hover-class="inv-btn--h" hover-stay-time="80" bindtap="closeInvite">
        <view class="inv-btn__t">邀请为读写成员</view>
        <view class="inv-btn__d">可记账、改删自己的记录</view>
      </button>
      <button class="inv-btn" open-type="share" data-role="ro" hover-class="inv-btn--h" hover-stay-time="80" bindtap="closeInvite">
        <view class="inv-btn__t">邀请为只读成员</view>
        <view class="inv-btn__d">只能查看账目与统计，可用 AI 问答</view>
      </button>
      <view class="inv-cancel" hover-class="pressed" hover-stay-time="80" bindtap="closeInvite">取消</view>
    </view>
  </view>
</view>
