<view class="screen" style="padding-bottom:calc(200rpx + env(safe-area-inset-bottom))">
  <loading show="{{loading}}"></loading>
  <nav-bar back="{{true}}" center="{{true}}" title="分账结算" sub="{{header}}"></nav-bar>

  <!-- 概览：总支出 + 我的净额 -->
  <view class="summary">
    <view class="summary__glow"></view>
    <view class="summary__label">{{header}}</view>
    <view class="summary__balance num">{{myNet}}</view>
    <view class="summary__row">
      <view class="summary__cell"><view class="k">总支出</view><view class="v num">{{totalExpense}}</view></view>
      <view class="summary__cell"><view class="k">你的垫付</view><view class="v num">{{myPaid}}</view></view>
      <view class="summary__cell"><view class="k">你应摊</view><view class="v num">{{myShare}}</view></view>
    </view>
  </view>

  <!-- 结算方案 -->
  <view class="section-label">结算方案 <text class="muted">{{remain}}</text></view>
  <view wx:if="{{allSettled}}" class="settle-banner">
    <image src="{{ic.check}}"></image>全部结清，这本账已经两不相欠
  </view>
  <view wx:if="{{transfers.length}}" class="card--flush" style="border-top:1rpx solid var(--border);border-bottom:1rpx solid var(--border)">
    <view wx:for="{{transfers}}" wx:key="key" wx:for-item="t" class="transfer {{t.settled?'settled':''}}">
      <view class="transfer__flow">
        <view class="transfer__who"><avatar src="{{t.fromAvatar}}" initial="{{t.fromInitial}}" color="{{t.fromColor}}" size="40"></avatar><text class="ellip" style="max-width:170rpx">{{t.fromName}}</text></view>
        <image class="transfer__arrow" src="{{ic.arrow}}"></image>
        <view class="transfer__who"><avatar src="{{t.toAvatar}}" initial="{{t.toInitial}}" color="{{t.toColor}}" size="40"></avatar><text class="ellip" style="max-width:170rpx">{{t.toName}}</text></view>
      </view>
      <text class="transfer__amt num">{{t.amountText}}</text>
      <view class="btn btn--mini {{t.settled?'btn--ghost':'btn--primary'}}" data-i="{{index}}" hover-class="pressed" hover-stay-time="80" bindtap="toggleSettle">{{t.settled?'已结清 · 撤销':'标记结清'}}</view>
    </view>
  </view>
  <view class="foot-note left" style="padding-top:16rpx">系统按每笔的付款人与分摊自动算出「谁欠谁」，并合并为最少转账笔数。金额按各笔记账当天的汇率换算，之后不再变动。</view>

  <!-- 成员维度统计 -->
  <view class="section-label">成员维度</view>
  <view class="card--flush" style="border-top:1rpx solid var(--border);border-bottom:1rpx solid var(--border)">
    <view wx:for="{{members}}" wx:key="name" wx:for-item="m" class="mstat">
      <view class="mstat__name"><avatar src="{{m.avatarFileID}}" initial="{{m.initial}}" color="{{m.color}}" size="40"></avatar><text class="ellip">{{m.name}}</text></view>
      <view class="mstat__nums">
        <view class="cell"><view class="k">垫付</view><view class="v num">{{m.paid}}</view></view>
        <view class="cell"><view class="k">应摊</view><view class="v num">{{m.share}}</view></view>
        <view class="cell"><view class="k">净额</view><view class="v num {{m.pos?'net-pos':'net-neg'}}">{{m.net}}</view></view>
      </view>
    </view>
  </view>

  <!-- 分摊明细（可展开）-->
  <view style="padding:0 40rpx">
    <view class="li disclosure {{discOpen?'open':''}}" style="padding-left:0;padding-right:0" bindtap="toggleDisc">
      <view class="li__label" style="font-weight:600">分摊明细 · {{splitCount}} 笔</view>
      <image class="disclosure__chev" src="{{ic.chevron}}"></image>
    </view>
  </view>
  <view wx:if="{{discOpen}}" class="card--flush" style="border-top:1rpx solid var(--border);border-bottom:1rpx solid var(--border)">
    <view wx:for="{{splits}}" wx:key="title" wx:for-item="sp" class="split-row">
      <view class="split-row__top">
        <view class="split-row__title">{{sp.title}} <text wx:if="{{sp.fx}}" class="pill pill--fx">{{sp.fx}}</text></view>
        <text class="split-row__amt num">{{sp.amountText}}</text>
      </view>
      <view class="split-row__meta">
        <text class="pill">{{sp.payerName}}</text> {{sp.detail}}
        <view class="split-avatars">
          <avatar wx:for="{{sp.avatars}}" wx:key="initial" wx:for-item="av" src="{{av.avatarFileID}}" initial="{{av.initial}}" color="{{av.color}}" size="44"></avatar>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 记一笔（分账账本）-->
<view class="fab" style="bottom:calc(60rpx + env(safe-area-inset-bottom))" hover-class="pressed" hover-stay-time="80" bindtap="goAdd">
  <image src="{{ic.plus}}"></image>
</view>
