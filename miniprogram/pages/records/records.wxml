<view class="screen" style="padding-bottom:48rpx">
  <loading show="{{loading}}"></loading>
  <view class="sticky-header">
    <nav-bar back="{{true}}" center="{{true}}" title="{{title}}"></nav-bar>
    <view wx:if="{{summaryText}}" class="rec-summary">{{summaryText}}</view>
  </view>

  <!-- 与首页一致的按天分组记录列表 -->
  <block wx:for="{{groups}}" wx:key="date" wx:for-item="g">
    <view class="day-head"><text>{{g.date}}</text><text class="num">{{g.total}}</text></view>
    <view class="card--flush">
      <view
        wx:for="{{g.items}}"
        wx:key="id"
        wx:for-item="it"
        class="txn"
        hover-class="pressed"
        hover-stay-time="80"
        data-id="{{it.id}}"
        bindtap="goDetail"
      >
        <view class="txn__icon {{it.in ? 'in' : ''}}"><image src="{{it.iconSrc}}"></image></view>
        <view class="txn__body">
          <view class="txn__title">{{it.title}}</view>
          <view class="txn__meta">
            <avatar src="{{it.whoAvatar}}" initial="{{it.whoInitial}}" color="{{it.whoColor}}" size="40"></avatar>
            <text class="ellip">{{it.who}}</text>
          </view>
        </view>
        <view class="txn__amt">
          <view class="main num {{it.in ? 'amt-in' : 'amt-out'}}">{{it.amount}}</view>
          <view wx:if="{{it.fx}}" class="txn__fx">
            <text class="pill pill--fx">原{{it.fx}}</text>
            <text class="txn__fxnote">{{it.sub}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{empty && !loading}}" style="text-align:center;padding:120rpx 60rpx">
    <view style="font-size:32rpx;font-weight:600">没有符合条件的记录</view>
    <view class="muted" style="font-size:28rpx;margin-top:12rpx">换个月份或分类看看。</view>
  </view>

  <view wx:if="{{groups.length && loadingMore}}" class="load-more"><view class="mini-spin"></view>正在加载更早的记录…</view>
  <view wx:elif="{{groups.length && !hasMore}}" class="ai-disclaimer" style="padding-top:40rpx">已显示全部记录</view>
</view>
