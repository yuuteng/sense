/* 筛选摘要行 */
.rec-summary {
  margin: 8rpx var(--space-5) 0;
  padding: 18rpx 28rpx;
  border-radius: var(--radius-sm);
  background: rgba(0, 204, 249, 0.08);
  color: var(--accent-ink);
  font-size: 26rpx; font-weight: 600;
}

/* 外币行 + 触底加载（与首页一致） */
.txn__fx { display: flex; align-items: center; justify-content: flex-end; gap: 8rpx; margin-top: 6rpx; }
.txn__fxnote { font-size: 22rpx; color: var(--muted); white-space: nowrap; }
.load-more {
  display: flex; align-items: center; justify-content: center; gap: 14rpx;
  padding: 40rpx 0 12rpx; font-size: 24rpx; color: var(--muted);
}
.mini-spin {
  width: 30rpx; height: 30rpx; border-radius: 50%;
  border: 4rpx solid rgba(0,204,249,0.22); border-top-color: var(--accent);
  animation: mini-spin 0.8s linear infinite;
}
@keyframes mini-spin { to { transform: rotate(360deg); } }
