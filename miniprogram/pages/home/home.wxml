<view class="screen screen--pad">
  <loading show="{{loading}}"></loading>
  <view class="sticky-header">
    <nav-bar>
      <view slot="left" class="appbar__book" hover-class="appbar__book--press" hover-stay-time="80" bindtap="openSwitcher">
        <image src="{{bookIcon}}" style="width:30rpx;height:30rpx"></image>
        <text class="appbar__book-name">{{bookName}}</text>
        <image src="{{chevronDown}}" style="width:28rpx;height:28rpx"></image>
      </view>
      <view slot="right" class="cur-pill" hover-class="cur-pill--press" hover-stay-time="80" bindtap="openCurPicker">
        展示币种 {{curSym}} {{curCode}}
        <image src="{{chevronDown}}" style="width:24rpx;height:24rpx"></image>
      </view>
    </nav-bar>
  </view>

  <!-- 未初始化数据提示 -->
  <view wx:if="{{needInit}}" class="empty">
    <view class="empty__title">还没有账本数据</view>
    <view class="empty__sub">想先看看效果？到「我的」页点「载入演示数据」，一键生成一个演示账本。</view>
    <view class="btn btn--primary" style="display:inline-flex;margin-top:36rpx" hover-class="pressed" hover-stay-time="80" bindtap="goSettings">去载入演示数据</view>
  </view>

  <!-- 本月概要 -->
  <view wx:if="{{!needInit}}" class="summary">
    <view class="summary__glow"></view>
    <view class="summary__label">{{summary.monthLabel}}</view>
    <view class="summary__balance num {{summary.compact ? 'compact' : ''}}">{{summary.balance}}</view>
    <view class="summary__row">
      <view class="summary__cell">
        <view class="k"><text class="dot dot--in"></text>收入</view>
        <view class="v num">{{summary.income}}</view>
      </view>
      <view class="summary__cell">
        <view class="k"><text class="dot dot--out"></text>支出</view>
        <view class="v num">{{summary.expense}}</view>
      </view>
    </view>
  </view>

  <!-- 分账账本：结算直达入口（账本配置页里的入口保留，两处同去 settle） -->
  <view wx:if="{{!needInit && isSplit}}" class="group group--flat" style="margin-bottom:16rpx">
    <view class="li" hover-class="pressed" hover-stay-time="80" bindtap="goSettle">
      <view class="li__ic" style="background:rgba(255,205,47,0.16)"><image src="{{settleIcon}}"></image></view>
      <view class="li__label">分账结算</view>
      <view class="li__val">谁欠谁，一目了然 <image class="chevron" src="{{chevronIcon}}"></image></view>
    </view>
  </view>

  <!-- 记账列表（按天分组，倒序） -->
  <block wx:for="{{groups}}" wx:key="date" wx:for-item="g">
    <view class="day-head"><text>{{g.date}}</text><text class="num">{{g.total}}</text></view>
    <view class="card--flush">
      <view
        wx:for="{{g.items}}"
        wx:key="id"
        wx:for-item="it"
        class="txn {{it.pending ? 'txn--pending' : ''}}"
        hover-class="pressed"
        hover-stay-time="80"
        data-id="{{it.id}}"
        bindtap="goDetail"
      >
        <view class="txn__icon {{it.in ? 'in' : ''}}"><image src="{{it.iconSrc}}"></image></view>
        <view class="txn__body">
          <view class="txn__title">{{it.title}}</view>
          <view class="txn__meta">
            <avatar src="{{it.whoAvatar}}" initial="{{it.whoInitial}}" color="{{it.whoColor}}" size="40"></avatar>
            <text class="ellip">{{it.who}}</text>
          </view>
        </view>
        <view class="txn__amt">
          <view class="main num {{it.in ? 'amt-in' : 'amt-out'}}">{{it.amount}}</view>
          <view wx:if="{{it.fx}}" class="txn__fx">
            <text class="pill pill--fx">原{{it.fx}}</text>
            <text class="txn__fxnote">{{it.sub}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 零记录空态：给出路（PRD「空态给出路」）；只读成员无记账入口，文案区分 -->
  <view wx:if="{{!needInit && !loading && !groups.length}}" class="empty">
    <view class="empty__title">这个账本还没有记录</view>
    <block wx:if="{{canAdd}}">
      <view class="empty__sub">点右下角「＋ 记一笔」，3 步搞定</view>
      <view class="empty__sub" style="margin-top:4rpx">或去「助手」说一句：昨天打车 35</view>
    </block>
    <view wx:else class="empty__sub">你是只读成员：等其他成员记上第一笔，这里就会出现记录。</view>
  </view>

  <view wx:if="{{!needInit && groups.length && loadingMore}}" class="load-more"><view class="mini-spin"></view>正在加载更早的记录…</view>
  <view wx:elif="{{!needInit && groups.length && !hasMore}}" class="foot-note" style="padding-top:40rpx">已显示全部记录</view>

  <navigator wx:if="{{canAdd}}" class="fab" url="/pages/add/add" hover-class="pressed" hover-stay-time="80">
    <image src="{{plusIcon}}"></image><text>记一笔</text>
  </navigator>

  <book-switcher
    visible="{{switcherVisible}}"
    books="{{books}}"
    current-id="{{currentBookId}}"
    bind:select="onSwitcherSelect"
    bind:close="onSwitcherClose"
    bind:manage="goManageBooks"
  ></book-switcher>

  <currency-picker visible="{{curVisible}}" current="{{curCode}}" bind:select="onCurPick" bind:close="closeCurPicker"></currency-picker>
</view>
