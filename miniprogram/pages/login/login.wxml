<view class="screen login">
  <view class="status-spacer" style="height:{{statusBarHeight}}px"></view>

  <!-- 品牌 -->
  <view class="login__hero">
    <image class="login__logo" src="/brand/logo-vertical.png" mode="widthFix"></image>
    <view class="login__sub">简洁、协作、多币种的记账</view>
  </view>

  <!-- 头像 + 昵称 -->
  <view class="login__card">
    <view class="avatar-wrap">
      <button class="avatar-pick" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar-pick__img" src="{{avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="avatar-pick__ph">
          <text class="avatar-pick__plus">＋</text>
        </view>
      </button>
    </view>
    <view class="avatar-pick__tip">{{avatarUrl ? '点击更换头像' : '点击设置头像'}}</view>

    <input class="login__nickname" type="nickname" maxlength="20" placeholder="填写昵称" value="{{nickname}}" bindinput="onNickname" bindblur="onNickname" />
  </view>

  <!-- 底部 -->
  <view class="login__foot">
    <view class="btn btn--primary btn--block btn--lg" hover-class="pressed" hover-stay-time="80" bindtap="submit">登录并进入</view>
    <view class="ai-disclaimer" style="margin-top:20rpx">登录用于在账本里标识你，头像昵称之后可随时修改</view>
  </view>
</view>
