.login { padding: 0 48rpx calc(60rpx + env(safe-area-inset-bottom)); min-height: 100vh; display: flex; flex-direction: column; }
.login__brand { display: flex; align-items: center; gap: 20rpx; padding: 40rpx 0 8rpx; }
.login__card { margin-top: 48rpx; }
.avatar-pick {
  width: 176rpx; height: 176rpx; border-radius: 50%; padding: 0; margin: 0 auto;
  background: var(--surface); box-shadow: var(--shadow-soft); overflow: hidden;
  display: flex; align-items: center; justify-content: center;
}
.avatar-pick::after { border: none; }
.avatar-pick__img { width: 100%; height: 100%; }
.avatar-pick__ph { display: flex; flex-direction: column; align-items: center; gap: 8rpx; color: var(--muted); }
.avatar-pick__plus { font-size: 56rpx; line-height: 1; color: var(--accent); }
.avatar-pick__hint { font-size: 24rpx; }
.login__foot { margin-top: auto; padding-top: 48rpx; }
