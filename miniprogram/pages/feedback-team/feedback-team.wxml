<view class="screen screen--pad">
  <loading show="{{loading}}"></loading>
  <nav-bar back="{{true}}" center="{{true}}" title="客服团队"></nav-bar>

  <view class="section-label">Owner · 固定于云函数环境变量</view>
  <view class="group group--flat">
    <view wx:for="{{owners}}" wx:key="openid" class="li">
      <view class="li__label">{{item.name}}{{item.isMe ? '（我）' : ''}}</view>
      <text class="fb-status fb-status--processing">owner</text>
    </view>
  </view>

  <view class="section-label">客服 · {{admins.length}} 人</view>
  <view class="group group--flat">
    <view wx:if="{{!admins.length}}" class="li"><view class="li__label" style="color:var(--muted);font-weight:400">还没有客服，点下方按钮生成邀请码</view></view>
    <view wx:for="{{admins}}" wx:key="openid" class="li">
      <view class="li__label">{{item.name}}<view class="li__val">{{item.timeLabel}} 加入</view></view>
      <view class="btn btn--danger fb-team__rm" hover-class="pressed" hover-stay-time="80" data-openid="{{item.openid}}" data-name="{{item.name}}" bindtap="remove">移除</view>
    </view>
  </view>

  <view class="ai-disclaimer left">邀请码 24 小时有效、一次性使用；客服可查看与回复全部工单、修改处理状态，但不能邀请或移除其他客服。</view>

  <view style="padding:40rpx 40rpx calc(60rpx + env(safe-area-inset-bottom))">
    <view class="btn btn--primary btn--block btn--lg" hover-class="pressed" hover-stay-time="80" bindtap="invite">生成邀请码</view>
  </view>
</view>
