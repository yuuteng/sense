/* 导出配置页：复用全局 group / li / chip / field-row / action-bar 令牌与组件类 */

/* 快选 chips 容器（时间范围、导出格式） */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 var(--space-5);
}

/* 单行等宽 chips：压缩内边距与字号，保证 4~5 项一行放下、整页免滚动 */
.chips--row { flex-wrap: nowrap; gap: 12rpx; }
.chips--row .chip {
  flex: 1;
  justify-content: center;
  padding: 12rpx 4rpx;
  font-size: 24rpx;
  min-height: 64rpx;
}

/* 选中项右侧勾选标记 */
.check {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}
