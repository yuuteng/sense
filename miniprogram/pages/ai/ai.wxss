/* ai 页面样式继承自 app.wxss；以下为语音输入 */

/* 输入框容器：麦克风按钮绝对定位在框内右侧（微信风格） */
.composer__field { flex: 1; min-width: 0; position: relative; display: flex; }
.composer__field .composer__input { flex: 1; width: 100%; }
.composer__input--mic { padding-right: 88rpx; }
.composer__mic {
  position: absolute; right: 8rpx; top: 50%; transform: translateY(-50%);
  width: 72rpx; height: 72rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.composer__mic image { width: 40rpx; height: 40rpx; }
.composer__mic--on { background: rgba(0, 204, 249, 0.14); }

/* 录音浮层：居中面板 + 声浪动画；上滑取消变红 */
.rec-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 200;
  display: flex; align-items: center; justify-content: center;
  background: rgba(20, 30, 40, 0.25);
}
.rec-panel {
  width: 320rpx; padding: 48rpx 0 36rpx;
  border-radius: var(--radius-md);
  background: rgba(40, 48, 58, 0.92);
  display: flex; flex-direction: column; align-items: center; gap: 20rpx;
}
.rec-panel__ic { width: 72rpx; height: 72rpx; }
.rec-panel__tip { color: #ffffff; font-size: 24rpx; }
.rec-panel--cancel { background: rgba(196, 30, 90, 0.92); }

/* 声浪：5 根柱子错峰伸缩 */
.rec-wave { display: flex; align-items: center; gap: 8rpx; height: 44rpx; }
.rw { width: 8rpx; height: 16rpx; border-radius: 4rpx; background: #7fe6ff; animation: rec-bounce 0.9s ease-in-out infinite; }
.rw:nth-child(2) { animation-delay: 0.15s; }
.rw:nth-child(3) { animation-delay: 0.3s; }
.rw:nth-child(4) { animation-delay: 0.45s; }
.rw:nth-child(5) { animation-delay: 0.6s; }
@keyframes rec-bounce { 0%, 100% { height: 12rpx; } 50% { height: 40rpx; } }
