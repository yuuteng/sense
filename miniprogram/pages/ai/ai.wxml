<view class="screen" style="padding-bottom:calc(380rpx + env(safe-area-inset-bottom))">
  <loading show="{{loading}}"></loading>
  <view class="sticky-header">
    <nav-bar>
      <view slot="left" class="appbar__book" hover-class="appbar__book--press" hover-stay-time="80" bindtap="openSwitcher">
        <image src="{{bookIcon}}" style="width:30rpx;height:30rpx"></image>
        <text class="appbar__book-name">{{bookName}}</text>
        <image src="{{chevronDown}}" style="width:28rpx;height:28rpx"></image>
      </view>
      <view slot="right" class="cur-pill" hover-class="cur-pill--press" hover-stay-time="80" bindtap="openCurPicker">
        展示币种 {{curSym}} {{curCode}}
        <image src="{{chevronDown}}" style="width:24rpx;height:24rpx"></image>
      </view>
    </nav-bar>
  </view>

  <view class="chat">
    <!-- 拆两行：避免长句在「50 次 AI 调用」中间被折行；包一层避免吃 .chat 的 flex gap -->
    <view class="ai-disclaimer">
      <view>AI 分析基于你的账本数据进行 · 会话完整保留</view>
      <view wx:if="{{quotaText}}">{{quotaText}}</view>
    </view>

    <!-- 空会话起手引导：三能力说清 + 可点示例（点击只填输入框，不自动发送/入账） -->
    <view wx:if="{{!loading && !messages.length}}" class="ai-starter">
      <view class="ai-starter__title">可以这样开始</view>
      <view class="ai-starter__row" wx:for="{{starters}}" wx:key="q" hover-class="pressed" hover-stay-time="80" data-q="{{item.q}}" bindtap="onStarter">
        <text class="ai-starter__hint">{{item.hint}}</text>
        <text class="ai-starter__q">「{{item.q}}」</text>
      </view>
      <view class="ai-starter__row ai-starter__row--static">
        <text class="ai-starter__hint">拍收据</text>
        <text class="ai-starter__q">点左下角 📷 上传小票，自动识别成一笔待确认的账</text>
      </view>
    </view>

    <block wx:for="{{messages}}" wx:key="index" wx:for-item="m">
      <!-- 用户：收据图片 -->
      <view wx:if="{{m.role==='me' && m.receipt}}" class="msg msg--me receipt">
        <image wx:if="{{m.image}}" class="receipt-img" src="{{m.image}}" mode="aspectFill"></image>
        <view wx:else class="receipt-img">🧾 上传的收据图片</view>
      </view>
      <!-- 用户：文字 -->
      <view wx:elif="{{m.role==='me'}}" class="msg msg--me">{{m.text}}</view>
      <!-- AI：正在输入 -->
      <view wx:elif="{{m.role==='ai' && m.typing}}" class="msg msg--ai">
        <view class="typing"><view class="tdot"></view><view class="tdot"></view><view class="tdot"></view></view>
      </view>
      <!-- AI：文本（含加粗）-->
      <rich-text wx:elif="{{m.role==='ai'}}" class="msg msg--ai" nodes="{{m.html}}"></rich-text>
      <!-- 预填确认卡片 -->
      <view
        wx:elif="{{m.role==='card'}}"
        class="confirm-card {{m.state==='done'?'done':''}}"
        style="{{m.state==='dropped'?'opacity:0.5':''}}"
      >
        <view class="confirm-card__head">
          <image src="{{m.state==='done'?ic.checkDone:(m.kind==='收据识别'?ic.checkbox:ic.clock)}}"></image>
          <text wx:if="{{m.state==='done'}}">已入账，可在首页查看</text>
          <text wx:else>待确认 · {{m.kind}}</text>
        </view>
        <view class="confirm-card__body">
          <view wx:for="{{m.rows}}" wx:key="k" wx:for-item="r" class="confirm-row">
            <text class="k">{{r.k}}</text>
            <text class="v {{r.k==='金额'||r.k==='日期'?'num':''}}">{{r.v}}<text wx:if="{{r.extra}}" class="muted" style="font-weight:400"> {{r.extra}}</text><text wx:if="{{r.edit}}" class="edit">改</text></text>
          </view>
        </view>
        <view wx:if="{{m.state!=='done'}}" class="confirm-card__foot">
          <block wx:if="{{m.state==='pending'}}">
            <view class="btn btn--ghost" data-i="{{index}}" hover-class="pressed" hover-stay-time="80" bindtap="dropCard">放弃</view>
            <view class="btn btn--ghost" data-i="{{index}}" hover-class="pressed" hover-stay-time="80" bindtap="editDraft">编辑</view>
            <view class="btn btn--primary" data-i="{{index}}" hover-class="pressed" hover-stay-time="80" bindtap="confirmCard">确认入账</view>
          </block>
          <text wx:elif="{{m.state==='dropped'}}" class="muted" style="padding:18rpx;font-size:26rpx">已放弃，未入账</text>
        </view>
      </view>
    </block>
  </view>
</view>

<!-- 输入区（固定，浮于 tabBar 之上）-->
<view class="composer">
  <view class="composer__ic" hover-class="pressed" hover-stay-time="80" bindtap="onUpload"><image src="{{ic.camera}}"></image></view>
  <view class="composer__field">
    <input
      class="composer__input composer__input--mic"
      placeholder="{{placeholder}}"
      placeholder-class="input-ph"
      value="{{input}}"
      bindinput="onInput"
      confirm-type="send"
      bindconfirm="onSend"
      cursor-spacing="20"
    />
    <!-- 语音按钮：微信风格放输入框内右侧，有文字时隐藏；按住说话/上滑取消 -->
    <view
      wx:if="{{!input}}"
      class="composer__mic {{recording ? 'composer__mic--on' : ''}}"
      catchtouchstart="micStart"
      catchtouchmove="micMove"
      catchtouchend="micEnd"
      catchtouchcancel="micCancel"
    >
      <image src="{{ic.mic}}"></image>
    </view>
  </view>
  <view class="composer__send" hover-class="pressed" hover-stay-time="80" bindtap="onSend"><image src="{{ic.send}}"></image></view>
</view>

<!-- 录音/识别浮层 -->
<view wx:if="{{recording || recognizing}}" class="rec-mask">
  <view class="rec-panel {{recCancel ? 'rec-panel--cancel' : ''}}">
    <image class="rec-panel__ic" src="{{recCancel ? ic.micCancel : ic.micBig}}"></image>
    <view wx:if="{{recording && !recCancel}}" class="rec-wave"><view class="rw"></view><view class="rw"></view><view class="rw"></view><view class="rw"></view><view class="rw"></view></view>
    <view class="rec-panel__tip">{{recognizing ? '识别中…' : (recCancel ? '松开取消' : '松开结束 · 上滑取消')}}</view>
  </view>
</view>

<book-switcher
  visible="{{switcherVisible}}"
  books="{{books}}"
  current-id="{{currentBookId}}"
  bind:select="onSwitcherSelect"
  bind:close="onSwitcherClose"
  bind:manage="goManageBooks"
></book-switcher>

<currency-picker visible="{{curVisible}}" current="{{curCode}}" bind:select="onCurPick" bind:close="closeCurPicker"></currency-picker>
